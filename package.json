{
  "name": "codemap-ai",
  "version": "3.8.0",
  "description": "Call graph analyzer for understanding code impact and execution flows - built for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codemap": "dist/cli.js",
    "codemap-ai": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "homepage": "",
  "bugs": {
    "url": ""
  },
  "scripts": {
    "build": "tsup && npm run build:web",
    "build:web": "vite build src/web/app && rm -rf web-dist && mv src/web/app/dist web-dist",
    "dev": "tsup --watch",
    "dev:web": "vite src/web/app",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "call-graph",
    "impact-analysis",
    "dependency-graph",
    "claude-code",
    "mcp-server",
    "code-analysis",
    "flow-tracing"
  ],
  "author": "Sahan Nishshanka",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xyflow/react": "^12.0.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.0.0",
    "dagre": "^0.8.5",
    "elkjs": "^0.9.0",
    "express": "^5.0.0",
    "glob": "^10.3.10",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.563.0",
    "open": "^10.0.0",
    "ora": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.0.0"

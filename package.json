{
  "name": "codemap-ai",
  "version": "4.0.0",
  "description": "Call graph analyzer for understanding code impact and execution flows - built for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codemap": "dist/cli.js",
    "codemap-ai": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svhozt/codemap-ai.git"
  },
  "homepage": "https://github.com/svhozt/codemap-ai#readme",
  "bugs": {
    "url": "https://github.com/svhozt/codemap-ai/issues"
  },
  "scripts": {
    "build": "tsup && npm run build:web",
    "build:web": "vite build",
    "dev": "tsup --watch",
    "dev:web": "vite",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/app",
    "lint": "eslint .",
    "pretest": "tsup --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "call-graph",
    "impact-analysis",
    "dependency-graph",
    "code-analysis",
    "static-analysis",
    "flow-tracing",
    "tree-sitter",
    "python",
    "typescript",
    "javascript",
    "fastapi",
    "claude-code",
    "claude",
    "mcp",
    "mcp-server",
    "cli"
  ],
  "author": "Sahan Nishshanka",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "express": "^5.2.1",
    "glob": "^14.0.6",
    "js-yaml": "^4.1.1",
    "open": "^10.0.0",
    "ora": "^8.0.1",
    "tree-sitter": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dagre": "^0.7.52",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xyflow/react": "^12.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "eslint": "^9.0.0",
    "lucide-react": "^0.563.0",
    "postcss": "^8.4.47",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ]
}
